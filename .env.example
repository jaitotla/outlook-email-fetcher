

# OpenAI (Optional - for LLM and embeddings)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (Optional - for Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Pinecone (Optional - for cloud vector DB)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment

# Configuration
VECTOR_DB_TYPE=faiss  # Options: faiss, pinecone
LLM_PROVIDER=openai   # Options: openai, anthropic, ollama
EMBEDDING_PROVIDER=openai  # Options: openai, local
