    EP --> DRAFT
    EP --> LABEL
    EP --> STORE
    EP --> PREPROC
    
    CHAT --> LLM_SVC
    CHAT --> EMBED_SVC
    DRAFT --> LLM_SVC
    DRAFT --> EMBED_SVC
    LABEL --> LLM_SVC
    STORE --> EMBED_SVC
    
    LLM_SVC --> OPENAI
    LLM_SVC --> ANTHROPIC
    LLM_SVC --> GEMINI
    LLM_SVC --> OLLAMA
    LLM_SVC --> INBUILT
    INBUILT --> FLASK_SVC
    
    EMBED_SVC --> CHROMA
