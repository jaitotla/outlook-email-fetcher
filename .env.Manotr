
# Encryption Salts (REQUIRED - generated at setup, never hardcoded)
SETTINGS_ENCRYPTION_SALT="wefsdgredbrfvcbverdxfved"
IMAP_ENCRYPTION_SALT="tesdgersdfxfqwasdfxchesdxfesd"

# OpenAI (Optional - for LLM and embeddings)
OPENAI_API_KEY=""

# Anthropic (Optional - for Claude)
ANTHROPIC_API_KEY=""

# Groq (Optional)
GROQ_API_KEY=""

# Gemini (Optional)
GEMINI_API_KEY=""

# Pinecone (Optional - for cloud vector DB)
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""

# Ollama (Optional - local or remote LLM)
OLLAMA_API_KEY=""
OLLAMA_BASE_URL=""

# Weaviate (Optional - for vector DB)
WEAVIATE_API_KEY=""
WEAVIATE_URL=""



# =============================================================================
# INBUILT MODE - Central Server URLs (REQUIRED)
# =============================================================================
# These are required for the agent to function. They point to your central
# Flask and Ollama servers for LLM and embedding services.
# DO NOT commit actual URLs to git - keep sensitive values in .env only

INBUILT_FLASK_URL=""
INBUILT_OLLAMA_URL=""

# Optional: Flask local fallback (for local development)
# INBUILT_FLASK_LOCAL=http://localhost:5050

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=5051
ENVIRONMENT=development

# Backend API
BACKEND_API_URL=http://localhost:3000

# MongoDB
MONGODB_URI=

# =============================================================================
# LLM PROVIDERS (Optional - uses inbuilt if not specified)
# =============================================================================
# Default provider
# LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=""
# OPENAI_MODEL=gpt-4o-mini