{
  "manifest_version": 2,
  "name": "Email Thread Assistant",
  "description": "Analyze and interact with your email threads using AI",
  "version": "1.0.0",
  "author": "Your Name",
  "applications": {
    "gecko": {
      "id": "email-assistant@thunderbird.addon",
      "strict_min_version": "91.0"
    }
  },
  "icons": {
    "64": "icons/icon-64.png",
    "32": "icons/icon-32.png"
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "storage",
    "compose",
    "http://43.204.98.38:8000/*",
    "https://43.204.98.38:8000/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "message_display_action": {
    "default_title": "Email Thread Assistant",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}