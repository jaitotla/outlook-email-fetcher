# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Backend API
BACKEND_API_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/openmailbot

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Gemini
GOOGLE_API_KEY=your-google-api-key

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=openmailbot-emails

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Vector DB Settings
VECTOR_DB_TYPE=pinecone  # pinecone, faiss, or chroma
EMBEDDING_MODEL=text-embedding-ada-002  # or sentence-transformers model
EMBEDDING_DIMENSION=1536

# LLM Settings
DEFAULT_LLM_PROVIDER=openai  # openai, anthropic, or gemini
DEFAULT_MODEL=gpt-4-turbo-preview
MAX_TOKENS=2048
TEMPERATURE=0.7

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
