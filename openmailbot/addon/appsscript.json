{
  "timeZone": "America/New_York",
  "dependencies": {},
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "oauthScopes": [
    "https://www.googleapis.com/auth/gmail.readonly",
    "https://www.googleapis.com/auth/gmail.modify",
    "https://www.googleapis.com/auth/userinfo.email",
    "https://www.googleapis.com/auth/script.external_request"
  ],
  "gmail": {
    "name": "OpenMailBot",
    "logoUrl": "https://openmailbot.com/logo.png",
    "contextualTriggers": [
      {
        "unconditional": {},
        "onTriggerFunction": "onGmailMessageOpen"
      }
    ],
    "openLinkUrlPrefixes": [
      "https://openmailbot.com",
      "https://api.openmailbot.com"
    ],
    "universalActions": [
      {
        "label": "OpenMailBot Settings",
        "openLink": "https://openmailbot.com/settings"
      }
    ]
  }
}
