yarn-error.log*
logs/

# Database
*.sqlite
*.db
data/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.pytest_cache/

# FAISS indices
*.index
*.faiss

# Misc
.cache/
temp/
tmp/
